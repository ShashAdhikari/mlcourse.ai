{
  "appId": "com.financetracker.android",
  "appName": "FinanceTracker",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#f8fafc",
    "allowMixedContent": false,
    "useLegacyBridge": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#f8fafc",
      "showSpinner": false,
      "spinnerColor": "#1e40af"
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#f8fafc"
    }
  }
}
