{
  "appId": "com.financetracker.ios",
  "appName": "FinanceTracker",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#f8fafc",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#f8fafc",
      "showSpinner": false,
      "spinnerColor": "#1e40af"
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#f8fafc"
    }
  }
}
